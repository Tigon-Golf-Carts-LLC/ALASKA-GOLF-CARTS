        {
          "@type": "Question",
          "name": "How much does a golf cart cost at Discounted Golf Carts?",
          "acceptedAnswer": {"@type": "Answer", "text": "New golf carts at Discounted Golf Carts start at approximately $9,995. Used and pre-owned golf carts typically range from $4,500 to $12,000 depending on brand, age, condition, and features. Call 1-888-840-4490 for current pricing."}
        },
        {
          "@type": "Question",
          "name": "What brands of golf carts does Discounted Golf Carts sell?",
          "acceptedAnswer": {"@type": "Answer", "text": "Discounted Golf Carts is an authorized dealer for 13 brands: American Custom Golf Carts, Bintelli, Club Car, COLEMAN, COLUMBIA, CRICKET, Denago, Evolution, EZGO (E-Z-GO), Icon, Star EV, Tara, and Yamaha."}
        },
        {
          "@type": "Question",
          "name": "Does Discounted Golf Carts offer financing?",
          "acceptedAnswer": {"@type": "Answer", "text": "Yes. Financing is available through six partners: Sheffield Financial (0% APR), BLI Heartland (rent-to-own), DLL Financial Solutions, Roadrunner/Octane, Univest Capital, and Dealer Direct. Terms up to 48 months."}
        },
        {
          "@type": "Question",
          "name": "What is a street-legal golf cart?",
          "acceptedAnswer": {"@type": "Answer", "text": "A Low Speed Vehicle (LSV) meets FMVSS 500 federal safety standards for operation on public roads with posted limits of 35 mph or less. Required equipment includes headlights, taillights, turn signals, mirrors, seat belts, horn, and a VIN."}
        },
        {
          "@type": "Question",
          "name": "How many locations does Discounted Golf Carts have?",
          "acceptedAnswer": {"@type": "Answer", "text": "Discounted Golf Carts operates 14 retail locations across 9 states: Pennsylvania (Hatfield, Long Pond, Scranton), New Jersey (Ocean View, Bayville, Waretown, Rio Grande), Delaware (Dover), North Carolina (Raleigh), Indiana (South Bend), Virginia (Gloucester Point), Florida (Lecanto), South Carolina (Orangeburg), and Ohio (Swanton)."}
        },
        {
          "@type": "Question",
          "name": "Does Discounted Golf Carts deliver nationwide?",
          "acceptedAnswer": {"@type": "Answer", "text": "Yes. Nationwide delivery is available from any of the 14 locations. Call 1-888-840-4490 for a delivery quote."}
        },
        {
          "@type": "Question",
          "name": "Does Discounted Golf Carts accept trade-ins?",
          "acceptedAnswer": {"@type": "Answer", "text": "Yes. Trade-ins are accepted at all 14 locations. Call 1-888-840-4490 to discuss your trade-in value."}
        },
